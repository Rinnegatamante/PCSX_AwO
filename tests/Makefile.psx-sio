CC ?= clang
CFLAGS ?= -std=c99 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/psx-sio-tests
TARGET := $(BUILD)/test-psx-sio

.PHONY: all test sanitize clean
all: $(TARGET)

$(BUILD):
	@mkdir -p $@

$(TARGET): libpcsxcore/arcade/psx_sio.c libpcsxcore/arcade/psx_sio.h \
		tests/test_psx_sio.c libpcsxcore/arcade/psx_sio_LICENSE.txt | $(BUILD)
	$(CC) $(CFLAGS) -Ilibpcsxcore/arcade \
		libpcsxcore/arcade/psx_sio.c tests/test_psx_sio.c -o $@

test: $(TARGET)
	$(TARGET)

sanitize:
	$(MAKE) -f tests/Makefile.psx-sio BUILD=$(BUILD)-sanitize \
		CFLAGS='-std=c99 -O1 -g -Wall -Wextra -Werror -fsanitize=address,undefined -fno-omit-frame-pointer' test

clean:
	rm -rf $(BUILD) $(BUILD)-sanitize
