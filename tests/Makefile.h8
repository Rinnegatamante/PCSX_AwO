CXX ?= clang++
CXXFLAGS ?= -std=c++11 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/h8-tests
PERIPHERALS := libpcsxcore/arcade/h8_adc.cpp libpcsxcore/arcade/h8_sci.cpp libpcsxcore/arcade/h8_timer16.cpp
PERIPHERAL_HEADERS := $(PERIPHERALS:.cpp=.h)
TARGET := $(BUILD)/h8-standalone
TIMESTAMP_TARGET := $(BUILD)/h8-timestamp
SOFT_RESET_TARGET := $(BUILD)/h8-soft-reset
.PHONY: all test irq-test rom-test deadline-test deadline-ubsan-test clean
all: $(TARGET)
$(TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_standalone.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_standalone.cpp -o $@
$(TIMESTAMP_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_timestamp.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_timestamp.cpp -o $@
$(SOFT_RESET_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_soft_reset.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_soft_reset.cpp -o $@
DEADLINE_TARGET := $(BUILD)/h8-deadline
$(DEADLINE_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_deadline.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_deadline.cpp -o $@
test: $(TARGET) $(TIMESTAMP_TARGET) $(SOFT_RESET_TARGET) $(DEADLINE_TARGET)
	$(TARGET)
	$(TIMESTAMP_TARGET)
	$(SOFT_RESET_TARGET)
	$(DEADLINE_TARGET)
IRQ_TARGET := $(BUILD)/h8-irq-filter
$(IRQ_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_irq_filter.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) tests/h8_irq_filter.cpp $(PERIPHERALS) -o $@
irq-test: $(IRQ_TARGET)
	$(IRQ_TARGET)
deadline-test: $(DEADLINE_TARGET)
	$(DEADLINE_TARGET)
SAN_DIR := $(BUILD)/ubsan
SAN_FLAGS := -std=c++11 -O1 -g -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all
deadline-ubsan-test:
	@mkdir -p $(SAN_DIR)
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_timestamp.cpp -o $(SAN_DIR)/h8-timestamp
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_soft_reset.cpp -o $(SAN_DIR)/h8-soft-reset
	$(CXX) $(SAN_FLAGS) tests/h8_irq_filter.cpp $(PERIPHERALS) -o $(SAN_DIR)/h8-irq-filter
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_deadline.cpp -o $(SAN_DIR)/h8-deadline
	$(SAN_DIR)/h8-timestamp
	$(SAN_DIR)/h8-soft-reset
	$(SAN_DIR)/h8-irq-filter
	$(SAN_DIR)/h8-deadline
rom-test: $(TARGET)
	$(TARGET) artifacts/system12/sub.bin 120
clean:
	rm -rf $(BUILD)
