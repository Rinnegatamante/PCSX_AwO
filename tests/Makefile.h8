CXX ?= clang++
CXXFLAGS ?= -std=c++11 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/h8-tests
TARGET := $(BUILD)/h8-standalone
TIMESTAMP_TARGET := $(BUILD)/h8-timestamp
.PHONY: all test irq-test rom-test clean
all: $(TARGET)
$(TARGET): libpcsxcore/arcade/h8.cpp libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_standalone.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp tests/h8_standalone.cpp -o $@
$(TIMESTAMP_TARGET): libpcsxcore/arcade/h8.cpp libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_timestamp.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp tests/h8_timestamp.cpp -o $@
test: $(TARGET) $(TIMESTAMP_TARGET)
	$(TARGET)
	$(TIMESTAMP_TARGET)
IRQ_TARGET := $(BUILD)/h8-irq-filter
$(IRQ_TARGET): libpcsxcore/arcade/h8.cpp libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_irq_filter.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) tests/h8_irq_filter.cpp -o $@
irq-test: $(IRQ_TARGET)
	$(IRQ_TARGET)
rom-test: $(TARGET)
	$(TARGET) artifacts/system12/sub.bin 120
clean:
	rm -rf $(BUILD)
