CXX ?= c++
BUILD ?= build/ata-storage-tests
ARCADE := libpcsxcore/arcade
ATA_PORT := $(ARCADE)/ata_mame
INCLUDES := -I$(ARCADE) -I$(ATA_PORT)
COMMON := -std=c++20 -Wall -Wextra -Werror $(INCLUDES)
SOURCES := $(ARCADE)/ata_storage.cpp $(ATA_PORT)/atahle_port.cpp \
	$(ATA_PORT)/atastorage_port.cpp $(ARCADE)/gnet_pccard.cpp \
	$(ARCADE)/rf5c296.cpp tests/test_ata_storage.cpp
HEADERS := $(ARCADE)/ata_storage.h $(ARCADE)/gnet_pccard.h \
	$(ARCADE)/rf5c296.h $(ATA_PORT)/ata_mame_compat.h \
	$(ATA_PORT)/atahle_port.h $(ATA_PORT)/atastorage_port.h
TARGET := $(BUILD)/test-ata-storage
SAN_TARGET := $(BUILD)/test-ata-storage-sanitize

.PHONY: test sanitize clean regenerate check-generated
$(TARGET): $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD)
	$(CXX) $(COMMON) -O2 $(SOURCES) -o $@

$(SAN_TARGET): $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD)
	$(CXX) $(COMMON) -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) -o $@

test: $(TARGET)
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $(TARGET)

sanitize: $(SAN_TARGET)
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $(SAN_TARGET)

regenerate:
	python3 tools/port_mame_ata.py

check-generated:
	python3 tools/port_mame_ata.py --check

clean:
	rm -rf $(BUILD)
