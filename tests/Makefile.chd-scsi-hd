.DEFAULT_GOAL := test
CC := xcrun clang
CXX := xcrun clang++
PYTHON ?= python3
BUILD ?= build/chd-scsi-hd-tests
OPT ?= -O2 -g
include tools/mac-harness/libchdr.mk

ARCADE := libpcsxcore/arcade
CFLAGS := -arch arm64 -std=gnu99 $(OPT) -Wall $(LIBCHDR_CFLAGS)
CXXFLAGS := -arch arm64 -std=c++17 $(OPT) -Wall -Wextra -Werror -Wno-unused-parameter $(LIBCHDR_CFLAGS)
SOURCES := $(LIBCHDR_SOURCES)
OBJECTS := $(addprefix $(BUILD)/,$(SOURCES:.c=.o)) \
	$(LIBCHDR_EXTRA_OBJECTS) $(BUILD)/chd_hd.o $(BUILD)/nscsi_bus.o \
	$(BUILD)/nscsi_target.o $(BUILD)/nscsi_hd.o $(BUILD)/ncr53cf96.o
TARGET := $(BUILD)/test_chd_scsi_hd

.PHONY: test sanitize clean
$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
$(BUILD)/%.o: $(ARCADE)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -I$(ARCADE) -c $< -o $@
$(TARGET): tests/test_chd_scsi_hd.cpp $(OBJECTS)
	$(CXX) $(CXXFLAGS) -I$(ARCADE) $^ -lz -o $@
test: $(TARGET)
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $(PYTHON) tests/check_chd_scsi_hd.py --test $(TARGET)
sanitize:
	$(MAKE) -f tests/Makefile.chd-scsi-hd BUILD=$(BUILD)/sanitize OPT='-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer' test
clean:
	rm -rf $(BUILD)
-include $(OBJECTS:.o=.d)
