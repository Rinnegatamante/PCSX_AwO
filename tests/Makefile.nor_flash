CC ?= clang
CFLAGS ?= -O2 -Wall -Wextra -Werror -std=c99
TARGET = test_nor_flash

.PHONY: all run sanitize clean
all: $(TARGET)

$(TARGET): test_nor_flash.c ../libpcsxcore/arcade/nor_flash.c ../libpcsxcore/arcade/nor_flash.h
	$(CC) $(CFLAGS) -o $@ test_nor_flash.c ../libpcsxcore/arcade/nor_flash.c

run: $(TARGET)
	./$(TARGET)

sanitize:
	$(CC) -O1 -g -Wall -Wextra -Werror -std=c99 -fsanitize=address,undefined -fno-omit-frame-pointer -o $(TARGET)-sanitize test_nor_flash.c ../libpcsxcore/arcade/nor_flash.c
	./$(TARGET)-sanitize

clean:
	rm -f $(TARGET) $(TARGET)-sanitize
