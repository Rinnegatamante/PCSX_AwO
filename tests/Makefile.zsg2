CC ?= clang
CXX ?= clang++
CFLAGS ?= -std=c99 -O2 -g -Wall -Wextra -Werror
CXXFLAGS ?= -std=c++17 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/zsg2-tests
TARGET := $(BUILD)/test-zsg2
ARCADE := libpcsxcore/arcade
.PHONY: all test clean
all: $(TARGET)
$(BUILD):
	@mkdir -p $(BUILD)
$(BUILD)/zsg2.o: $(ARCADE)/zsg2.c $(ARCADE)/zsg2.h | $(BUILD)
	$(CC) $(CFLAGS) -MMD -MP -MF $(BUILD)/zsg2.d -I$(ARCADE) -c $< -o $@
$(TARGET): $(BUILD)/zsg2.o tests/zsg2_standalone.cpp $(ARCADE)/zsg2.h
	$(CXX) $(CXXFLAGS) -MMD -MP -MF $(BUILD)/test.d -I$(ARCADE) tests/zsg2_standalone.cpp $(BUILD)/zsg2.o -lm -o $@
-include $(BUILD)/zsg2.d $(BUILD)/test.d
test: $(TARGET)
	$(TARGET)
clean:
	rm -rf $(BUILD)
