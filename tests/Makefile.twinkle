CXX ?= clang++
PYTHON ?= python3
BUILD ?= build/twinkle-tests
GEN := $(BUILD)/generated
INCLUDES := -I$(GEN) -Ilibpcsxcore/arcade -Ilibpcsxcore/arcade/m68000
SOURCES := libpcsxcore/arcade/m68000.cpp $(GEN)/m68000-decode.cpp \
           $(GEN)/m68000-sdf.cpp $(GEN)/m68000-sdp.cpp \
           libpcsxcore/arcade/rf5c400.cpp libpcsxcore/arcade/twinkle_board.cpp \
           tests/test_twinkle_board.cpp
COMMON := -std=c++20 -g -Wall -Wextra -Wno-unused-parameter -Wno-unused-variable $(INCLUDES)
TARGET := $(BUILD)/test-twinkle
SAN_TARGET := $(BUILD)/test-twinkle-sanitize

.PHONY: test sanitize clean
$(GEN)/m68000-sdf.cpp: libpcsxcore/arcade/m68000/m68000.lst libpcsxcore/arcade/m68000/m68000gen.py
	@mkdir -p $(GEN)
	$(PYTHON) libpcsxcore/arcade/m68000/m68000gen.py sdf $< $@
$(GEN)/m68000-sdp.cpp: libpcsxcore/arcade/m68000/m68000.lst libpcsxcore/arcade/m68000/m68000gen.py
	@mkdir -p $(GEN)
	$(PYTHON) libpcsxcore/arcade/m68000/m68000gen.py sdp $< $@
$(GEN)/m68000-decode.cpp: libpcsxcore/arcade/m68000/m68000.lst libpcsxcore/arcade/m68000/m68000gen.py
	@mkdir -p $(GEN)
	$(PYTHON) libpcsxcore/arcade/m68000/m68000gen.py decode $< $@
$(GEN)/m68000-head.h: libpcsxcore/arcade/m68000/m68000.lst libpcsxcore/arcade/m68000/m68000gen.py
	@mkdir -p $(GEN)
	$(PYTHON) libpcsxcore/arcade/m68000/m68000gen.py header $< $@

$(TARGET): $(SOURCES) $(GEN)/m68000-head.h
	@mkdir -p $(BUILD)
	$(CXX) $(COMMON) -O2 $(SOURCES) -o $@
$(SAN_TARGET): $(SOURCES) $(GEN)/m68000-head.h
	@mkdir -p $(BUILD)
	$(CXX) $(COMMON) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) -o $@
test: $(TARGET)
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $(TARGET)
sanitize: $(SAN_TARGET)
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $(SAN_TARGET)
clean:
	rm -rf $(BUILD)
