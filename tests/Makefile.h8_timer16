CXX ?= clang++
CXXFLAGS ?= -std=c++11 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/h8-timer16-tests
TARGET := $(BUILD)/h8-timer16
SAN_TARGET := $(BUILD)/ubsan/h8-timer16

.PHONY: all test ubsan-test clean
all: $(TARGET)

$(TARGET): libpcsxcore/arcade/h8_timer16.cpp libpcsxcore/arcade/h8_timer16.h tests/h8_timer16_component.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8_timer16.cpp tests/h8_timer16_component.cpp -o $@

$(SAN_TARGET): libpcsxcore/arcade/h8_timer16.cpp libpcsxcore/arcade/h8_timer16.h tests/h8_timer16_component.cpp
	@mkdir -p $(BUILD)/ubsan
	$(CXX) -std=c++11 -O1 -g -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all libpcsxcore/arcade/h8_timer16.cpp tests/h8_timer16_component.cpp -o $@

test: $(TARGET)
	$(TARGET)

ubsan-test: $(SAN_TARGET)
	$(SAN_TARGET)

clean:
	rm -rf $(BUILD)
