void H8CPU::mulxu_b_r8h_r16l_full()
{
	m_NPC = m_PC & 0xffffff;
	m_PIR = read16i(m_PC);
	m_PC += 2;
	r16_w(m_IR[0], u8(r16_r(m_IR[0])) * r8_r(m_IR[0] >> 4));
	internal(m_has_mac ? 2 : 11);
	prefetch_done();
}

void H8CPU::divxu_b_r8h_r16l_full()
{
	m_NPC = m_PC & 0xffffff;
	m_PIR = read16i(m_PC);
	m_PC += 2;
	internal(11);
	m_TMP1 = r16_r(m_IR[0]);
	m_TMP2 = r8_r(m_IR[0] >> 4);
	m_CCR &= ~(F_Z|F_N);
	if(m_TMP2 & 0x80)
		m_CCR |= F_N;
	if(!m_TMP2) {
		m_CCR |= F_Z;
	} else {
		int q = m_TMP1 / m_TMP2;
		int r = m_TMP1 % m_TMP2;
		r16_w(m_IR[0], (q & 0xff) | ((r & 0xff) << 8));
	}
	prefetch_done();
}

