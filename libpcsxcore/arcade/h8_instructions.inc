void H8CPU::rts_full()
{
	m_PIR = read16i(m_PC);
	m_PC += 2;
	m_TMP1 = r32_r(7);
	if(m_mode_advanced) {
		m_TMP2 = u32(read16(m_TMP1)) << 16;
		m_TMP2 |= read16(m_TMP1+2);
		r32_w(7, m_TMP1+4);
	} else {
		m_TMP2 = read16(m_TMP1);
		r32_w(7, m_TMP1+2);
	}
	internal(1);
	m_PC = m_TMP2;
	m_NPC = m_PC & 0xffffff;
	m_PIR = read16i(m_PC);
	m_PC += 2;
	prefetch_done();
}

