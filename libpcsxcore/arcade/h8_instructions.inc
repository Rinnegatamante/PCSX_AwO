void H8CPU::state_reset_full()
{
	m_CCR |= (m_has_hc ? F_I : F_H);
	m_EXR = EXR_I | EXR_NC;
	if(m_mode_advanced) {
		m_IR[0] = read16i(0);
		m_IR[1] = read16i(2);
		m_PC = (u32(m_IR[0]) << 16) | m_IR[1];
	} else {
		m_PC = read16i(0);
	}
	update_irq_filter();
	m_NPC = m_PC & 0xffffff;
	m_PIR = read16i(m_PC);
	m_PC += 2;
	prefetch_done_noirq();
}

void H8CPU::state_irq_full()
{
	internal(1);
	m_TMP1 = r32_r(7) - 2;
	r32_w(7, m_TMP1);
	write16(m_TMP1, m_NPC);
	m_TMP1 = r32_r(7) - 2;
	r32_w(7, m_TMP1);
	write16(m_TMP1, (m_CCR << 8) | ((m_NPC >> 16) & 0xff));
	if(exr_in_stack()) {
		m_TMP1 = r32_r(7) - 2;
		r32_w(7, m_TMP1);
		write16(m_TMP1, m_EXR << 8);
	}
	debugger_exception_hook(m_taken_irq_vector);
	if(m_mode_advanced) {
		m_IR[0] = read16i(4*m_taken_irq_vector);
		m_IR[1] = read16i(4*m_taken_irq_vector+2);
		m_PC = (u32(m_IR[0]) << 16) | m_IR[1];
	} else {
		m_PC = read16i(2*m_taken_irq_vector);
	}
	internal(1);
	irq_setup();
	update_irq_filter();
	interrupt_taken();
	m_NPC = m_PC & 0xffffff;
	m_PIR = read16i(m_PC);
	m_PC += 2;
	prefetch_done_noirq();
}

