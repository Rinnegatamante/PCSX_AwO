		m_TMP1 = r32_r(7) - 4;
		r32_w(7, m_TMP1);
		write16(m_TMP1, m_TMP2 >> 16);
		write16(m_TMP1+2, m_TMP2);
	} else {
		m_TMP1 = r32_r(7) - 2;
