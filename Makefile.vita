TARGET := pcsx-awo
TITLE_ID := PCSXR0001
TITLE := PCSX AwO
CORE := pcsx_rearmed_libretro_vita.a
GIT_VERSION := $(shell git rev-parse --short HEAD)
ifeq ($(strip $(VITAGL_DIR)),)
VITAGL_DIR := ../vitaGL-pcsx-rearmed
endif
VITAGL_BUILD_FLAGS := HAVE_SHADER_CACHE=1 NO_DEBUG=1 READBACKS_SPEEDHACK=1 CIRCULAR_POOL_SPEEDHACK=1 DEPTH_STENCIL_HACK=1

PREFIX := arm-vita-eabi-
CC := $(PREFIX)gcc
CXX := $(PREFIX)g++
CFLAGS := -O3 -g -Wall -Wextra -DVITA -mcpu=cortex-a9 -mtune=cortex-a9 -mfpu=neon -marm \
	-fsingle-precision-constant -mword-relocations -ffast-math -fno-unwind-tables \
	-fno-asynchronous-unwind-tables -I$(VITAGL_DIR)/source -I$(VITASDK)/include -Ideps/libretro-common/include
LDFLAGS := -Wl,-q
LIBS := -lSDL3 -limgui $(VITAGL_DIR)/libvitaGL.a -lvitashark -lSceShaccCgExt -ltaihen_stub -lSceShaccCg_stub \
	-lSceKernelDmacMgr_stub -lpthread -lc -lSceCommonDialog_stub -lSceAudio_stub \
	-lSceLibKernel_stub -lmathneon -lkubridge_stub -lSceNet_stub -lSceNetCtl_stub \
	-lpng -lSceDisplay_stub -lSceGxm_stub -lSceAudioIn_stub \
	-Wl,--whole-archive -lSceSysmodule_stub -Wl,--no-whole-archive -lSceIme_stub \
	-lSceCamera_stub -lSceCtrl_stub -lSceTouch_stub -lSceMotion_stub -lm \
	-lSceAppMgr_stub -lSceHid_stub -lSceAppUtil_stub -lScePgf_stub -ljpeg \
	-lSceRtc_stub -lScePower_stub -lSceIofilemgr_stub -lcurl -lssl -lcrypto -lz
BUILD_DIR := build-vita
STANDALONE_OBJ := $(BUILD_DIR)/standalone.o
LIVEAREA_LAUNCH_OBJ := $(BUILD_DIR)/livearea_launch.o
ROM_SELECTOR_OBJ := $(BUILD_DIR)/rom_selector.o
SETTINGS_OBJ := $(BUILD_DIR)/settings.o
SAVESTATES_OBJ := $(BUILD_DIR)/savestates.o
POSTFX_OBJ := $(BUILD_DIR)/post_processing.o
POSTFX_PARAMS_OBJ := $(BUILD_DIR)/postfx_parameters.o
POSTFX_EMBEDDED_SRC := $(BUILD_DIR)/postfx_embedded.c
POSTFX_EMBEDDED_OBJ := $(BUILD_DIR)/postfx_embedded.o
POSTFX_NAMES := crt crt_bleeding daltonic fxaa gamma greyscale hue lcd3x negative sepia sharp_grid sharp_scanlines vignette
POSTFX_GXP := $(foreach name,$(POSTFX_NAMES),$(BUILD_DIR)/postfx/$(name)/vert.gxp $(BUILD_DIR)/postfx/$(name)/frag.gxp)
LIVEAREA_PATHS := icon0.png pic0.png livearea/contents/bg.png livearea/contents/startup.png livearea/contents/template.xml
LIVEAREA_ASSETS := $(addprefix assets/livearea/sce_sys/,$(LIVEAREA_PATHS))
LIVEAREA_VPK := $(foreach file,$(LIVEAREA_PATHS),-a assets/livearea/sce_sys/$(file)=sce_sys/$(file))
CORE_ARGS := platform=vita GIT_VERSION=$(GIT_VERSION) USE_LIBRETRO_VFS=0 \
		USE_ASYNC_CDROM=1 USE_ASYNC_GPU=1 USE_ASYNC_SPU=0 VITAGL_DIR=$(VITAGL_DIR)

.PHONY: all core vitagl clean
all: $(TARGET).vpk

vitagl:
	$(MAKE) -C $(VITAGL_DIR) $(VITAGL_BUILD_FLAGS) -j4

core:
	$(MAKE) -f Makefile.libretro $(CORE_ARGS) -j4

$(BUILD_DIR):
	mkdir -p $@

$(STANDALONE_OBJ): frontend/vita/standalone.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(LIVEAREA_LAUNCH_OBJ): frontend/vita/livearea_launch.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(ROM_SELECTOR_OBJ): frontend/vita/rom_selector.cpp | $(BUILD_DIR)
	$(CXX) $(CFLAGS) -std=gnu++11 -MMD -MP -c $< -o $@

$(SETTINGS_OBJ): frontend/vita/settings.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(SAVESTATES_OBJ): frontend/vita/savestates.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(POSTFX_OBJ): frontend/vita/post_processing.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(POSTFX_PARAMS_OBJ): frontend/vita/postfx_parameters.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(POSTFX_EMBEDDED_SRC): tools/embed_vita_postfx.py $(POSTFX_GXP)
	python tools/embed_vita_postfx.py $(BUILD_DIR)/postfx $@ $(POSTFX_NAMES)

$(POSTFX_EMBEDDED_OBJ): $(POSTFX_EMBEDDED_SRC)
	$(CC) $(CFLAGS) -Ifrontend/vita -c $< -o $@

$(BUILD_DIR)/postfx/%/vert.gxp: assets/postfx/%/vert.cg
	mkdir -p $(dir $@)
	psp2cgc -profile sce_vp_psp2 -o $@ $<

$(BUILD_DIR)/postfx/%/frag.gxp: assets/postfx/%/frag.cg
	mkdir -p $(dir $@)
	psp2cgc -profile sce_fp_psp2 -o $@ $<

$(TARGET).elf: vitagl core $(STANDALONE_OBJ) $(LIVEAREA_LAUNCH_OBJ) $(ROM_SELECTOR_OBJ) $(SETTINGS_OBJ) $(SAVESTATES_OBJ) $(POSTFX_OBJ) $(POSTFX_PARAMS_OBJ) $(POSTFX_EMBEDDED_OBJ)
	$(CXX) $(CFLAGS) $(LDFLAGS) $(STANDALONE_OBJ) $(LIVEAREA_LAUNCH_OBJ) $(ROM_SELECTOR_OBJ) $(SETTINGS_OBJ) $(SAVESTATES_OBJ) $(POSTFX_OBJ) $(POSTFX_PARAMS_OBJ) $(POSTFX_EMBEDDED_OBJ) $(CORE) $(LIBS) -o $@

$(TARGET).velf: $(TARGET).elf
	vita-elf-create $< $@

$(TARGET).vpk: $(TARGET).velf Roboto.ttf assets/Apache-2.0.txt assets/postfx/NOTICE.txt $(LIVEAREA_ASSETS)
	vita-make-fself -c -s -na $< eboot.bin
	vita-mksfoex -s TITLE_ID=$(TITLE_ID) -d ATTRIBUTE2=12 "$(TITLE)" param.sfo
	vita-pack-vpk -s param.sfo -b eboot.bin -a Roboto.ttf=Roboto.ttf -a assets/Apache-2.0.txt=licenses/Roboto-Apache-2.0.txt -a assets/postfx/NOTICE.txt=licenses/Daedalus-PostFX-NOTICE.txt $(LIVEAREA_VPK) $@

clean:
	$(MAKE) -f Makefile.libretro $(CORE_ARGS) clean || true
	rm -rf $(BUILD_DIR) $(TARGET).elf $(TARGET).velf $(TARGET).vpk eboot.bin param.sfo

-include $(STANDALONE_OBJ:.o=.d) $(LIVEAREA_LAUNCH_OBJ:.o=.d) $(ROM_SELECTOR_OBJ:.o=.d) $(SETTINGS_OBJ:.o=.d) $(SAVESTATES_OBJ:.o=.d) $(POSTFX_OBJ:.o=.d) $(POSTFX_PARAMS_OBJ:.o=.d)
