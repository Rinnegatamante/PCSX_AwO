TARGET := pcsx-rearmed-vita
TITLE_ID := PCSXR0001
TITLE := PCSX-ReARMed Vita
CORE := pcsx_rearmed_libretro_vita.a
GIT_VERSION := $(shell git rev-parse --short HEAD)

PREFIX := arm-vita-eabi-
CC := $(PREFIX)gcc
CXX := $(PREFIX)g++
CFLAGS := -O3 -g -Wall -Wextra -DVITA -mcpu=cortex-a9 -mtune=cortex-a9 -mfpu=neon -marm \
	-fsingle-precision-constant -mword-relocations -ffast-math -fno-unwind-tables \
	-fno-asynchronous-unwind-tables -I$(VITASDK)/include -Ideps/libretro-common/include
LDFLAGS := -Wl,-q
LIBS := -lSDL3 ../vitagl/libvitaGL.a -lvitashark -lSceShaccCgExt -ltaihen_stub -lSceShaccCg_stub \
	-lSceKernelDmacMgr_stub -lpthread -lc -lSceCommonDialog_stub -lSceAudio_stub \
	-lSceLibKernel_stub -lmathneon -lkubridge_stub -lSceNet_stub -lSceNetCtl_stub \
	-lpng -lSceDisplay_stub -lSceGxm_stub -lSceAudioIn_stub \
	-Wl,--whole-archive -lSceSysmodule_stub -Wl,--no-whole-archive -lSceIme_stub \
	-lSceCamera_stub -lSceCtrl_stub -lSceTouch_stub -lSceMotion_stub -lm \
	-lSceAppMgr_stub -lSceHid_stub -lSceAppUtil_stub -lScePgf_stub -ljpeg \
	-lSceRtc_stub -lScePower_stub -lSceIofilemgr_stub -lcurl -lssl -lcrypto -lz
BUILD_DIR := build-vita
STANDALONE_OBJ := $(BUILD_DIR)/standalone.o
CORE_ARGS := platform=vita GIT_VERSION=$(GIT_VERSION) USE_LIBRETRO_VFS=0 \
	USE_ASYNC_CDROM=0 USE_ASYNC_GPU=0 USE_ASYNC_SPU=0

.PHONY: all core clean
all: $(TARGET).vpk

core:
	$(MAKE) -f Makefile.libretro $(CORE_ARGS) -j4

$(BUILD_DIR):
	mkdir -p $@

$(STANDALONE_OBJ): frontend/vita/standalone.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(TARGET).elf: core $(STANDALONE_OBJ)
	$(CXX) $(CFLAGS) $(LDFLAGS) $(STANDALONE_OBJ) $(CORE) $(LIBS) -o $@

$(TARGET).velf: $(TARGET).elf
	vita-elf-create $< $@

$(TARGET).vpk: $(TARGET).velf
	vita-make-fself -c -s -na $< eboot.bin
	vita-mksfoex -s TITLE_ID=$(TITLE_ID) -d ATTRIBUTE2=12 "$(TITLE)" param.sfo
	vita-pack-vpk -s param.sfo -b eboot.bin $@

clean:
	$(MAKE) -f Makefile.libretro $(CORE_ARGS) clean || true
	rm -rf $(BUILD_DIR) $(TARGET).elf $(TARGET).velf $(TARGET).vpk eboot.bin param.sfo

-include $(STANDALONE_OBJ:.o=.d)
