+
+void mem_test_arm_stale_fault_gate() noexcept {
+    stale_fault_test_arrivals.store(0, std::memory_order_relaxed);
+    stale_fault_test_release.store(false, std::memory_order_release);
+}
+
+uint32_t mem_test_stale_fault_arrivals() noexcept {
+    return stale_fault_test_arrivals.load(std::memory_order_acquire);
+}
+
+void mem_test_release_stale_fault_gate() noexcept {
+    stale_fault_test_release.store(true, std::memory_order_release);
+}
+
+static void wait_at_stale_fault_test_gate() noexcept {
+    stale_fault_test_arrivals.fetch_add(1, std::memory_order_acq_rel);
+    while (!stale_fault_test_release.load(std::memory_order_acquire)) {
+    }
+}
+#endif
