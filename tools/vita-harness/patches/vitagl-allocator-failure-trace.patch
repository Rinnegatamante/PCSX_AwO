+#define PCSX_ALLOCATOR_TRACE_LIMIT 12
+static int pcsx_allocator_trace_events = 0;
+
+static void pcsx_trace_allocator(const char *stage, const char *route,
+		size_t alignment, size_t size, int retry_count) {
+	int event = __sync_fetch_and_add(&pcsx_allocator_trace_events, 1);
+	if (event >= PCSX_ALLOCATOR_TRACE_LIMIT)
+		return;
+	sceClibPrintf("pcsx-vita: VGL_ALLOC event=%d stage=%s route=%s size=%u align=%u unsafe=%d free(vram=%u ram=%u phycont=%u budget=%u external=unknown)\n",
+			event, stage, route, (unsigned)size, (unsigned)alignment, retry_count,
+			(unsigned)vgl_mem_get_free_space(VGL_MEM_VRAM),
+			(unsigned)vgl_mem_get_free_space(VGL_MEM_RAM),
+			(unsigned)vgl_mem_get_free_space(VGL_MEM_PHYCONT),
+			(unsigned)vgl_mem_get_free_space(VGL_MEM_BUDGET));
+}
