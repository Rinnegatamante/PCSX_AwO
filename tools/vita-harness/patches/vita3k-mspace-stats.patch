+namespace {
+struct MspaceStatsRecord {
+    uint32_t capacity;
+    // Exclude dlmalloc's own fixed mspace state from the guest's usage.
+    size_t baseline_in_use;
+    uint32_t peak_in_use;
+};
+
+std::unordered_map<mspace, MspaceStatsRecord> mspace_stats_records;
+
+struct GuestMspaceStats {
+    uint32_t capacity;
+    uint32_t unk;
+    uint32_t peak_in_use;
+    uint32_t current_in_use;
+};
+static_assert(sizeof(GuestMspaceStats) == 0x10);
+
+static uint32_t guest_mspace_size(uint64_t value) {
+    if constexpr (std::endian::native == std::endian::little)
+        return static_cast<uint32_t>(value);
+    else
+        return static_cast<uint32_t>(std::byteswap(static_cast<uint32_t>(value)));
+}
+
+static uint32_t current_mspace_in_use(mspace space, const MspaceStatsRecord &record) {
+    const size_t allocated = mspace_mallinfo(space).uordblks;
+    const size_t in_use = allocated > record.baseline_in_use ? allocated - record.baseline_in_use : 0;
+    return static_cast<uint32_t>(in_use > std::numeric_limits<uint32_t>::max()
+        ? std::numeric_limits<uint32_t>::max()
+        : in_use);
+}
+
+static void update_mspace_peak(mspace space) {
+    const auto it = mspace_stats_records.find(space);
+    if (it == mspace_stats_records.end())
+        return;
+    const uint32_t current = current_mspace_in_use(space, it->second);
+    if (current > it->second.peak_in_use)
+        it->second.peak_in_use = current;
+}
+
+static void write_mspace_stats(mspace space, Ptr<uint32_t> output, const MemState &mem) {
+    constexpr Address stats_size = sizeof(GuestMspaceStats);
+    const Address start = output.address();
+    if (!output || start > std::numeric_limits<Address>::max() - stats_size ||
+        !is_valid_addr_range(mem, start, start + stats_size))
+        return;
+
+    GuestMspaceStats stats {};
+    const auto it = mspace_stats_records.find(space);
+    if (it != mspace_stats_records.end()) {
+        stats.capacity = it->second.capacity;
+        stats.unk = it->second.capacity;
+        stats.peak_in_use = it->second.peak_in_use;
+        stats.current_in_use = current_mspace_in_use(space, it->second);
+    }
+    uint32_t guest_fields[4] = {
+        guest_mspace_size(stats.capacity), guest_mspace_size(stats.unk),
+        guest_mspace_size(stats.peak_in_use), guest_mspace_size(stats.current_in_use),
+    };
+    std::memcpy(output.get(mem), guest_fields, sizeof(guest_fields));
+}
+} // namespace
