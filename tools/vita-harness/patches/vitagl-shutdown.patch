+static int stop_garbage_collector(void) {
+	int result = 0;
+#ifndef HAVE_SINGLE_THREADED_GC
+	if (gc_started) {
+		gc_shutdown_requested = GL_TRUE;
+		int rc = sceKernelSignalSema(gc_mutex[0], 1);
+		if (rc < 0)
+			return rc;
+#ifdef HAVE_PTHREAD
+		rc = pthread_join(gc_thread, NULL);
+		if (rc != 0)
+			return -rc;
+#else
+		rc = sceKernelWaitThreadEnd(gc_thread, NULL, NULL);
+		if (rc < 0)
+			return rc;
+		rc = sceKernelDeleteThread(gc_thread);
+		if (rc < 0)
+			return rc;
+#endif
+		gc_started = GL_FALSE;
+	}
+	if (gc_mutex[0] > 0) {
+		int rc = sceKernelDeleteSema(gc_mutex[0]);
+		if (rc < 0)
+			return rc;
+		gc_mutex[0] = -1;
+	}
+	if (gc_mutex[1] > 0) {
+		int rc = sceKernelDeleteSema(gc_mutex[1]);
+		if (rc < 0)
+			return rc;
+		gc_mutex[1] = -1;
+	}
+#endif
+	for (int i = 0; i < FRAME_PURGE_FREQ; i++) {
+		for (int j = 0; j < FRAME_PURGE_LIST_SIZE; j++) {
+			if (!frame_purge_list[i][j])
+				break;
+			vgl_free(frame_purge_list[i][j]);
+			frame_purge_list[i][j] = NULL;
+		}
+		for (int j = 0; j < FRAME_PURGE_RENDERTARGETS_LIST_SIZE; j++) {
+			if (!frame_rt_purge_list[i][j])
+				break;
+			int rc = sceGxmDestroyRenderTarget(frame_rt_purge_list[i][j]);
+			if (rc < 0) {
+				if (!result) result = rc;
+			} else
+				frame_rt_purge_list[i][j] = NULL;
+		}
+	}
+	return result;
+}
+
+int vglShutdown(void) {
+	if (!gxm_initialized)
+		return 0;
+	int result = 0;
+
+#ifndef SKIP_SPLASHSCREEN
+	int splash_result = shutdown_splashscreen();
+	if (splash_result < 0) return splash_result;
+#endif
+
+	if (needs_end_scene && gxm_context) {
+		scene_end();
+		needs_end_scene = GL_FALSE;
+	}
+	if (gxm_context)
+		sceGxmFinish(gxm_context);
+	int rc = sceGxmDisplayQueueFinish();
+	if (rc < 0) return rc;
+
+	// The display queue has no more callbacks that can publish a framebuffer.
+	rc = sceDisplaySetFrameBuf(NULL, SCE_DISPLAY_SETBUF_NEXTFRAME);
+	if (rc < 0) return rc;
+	rc = sceDisplayWaitSetFrameBuf();
+	if (rc < 0) return rc;
+
+	rc = stop_garbage_collector();
+	if (rc < 0) return rc;
+	glReleaseShaderCompiler();
+
+	if (gxm_shader_patcher) {
+		rc = sceGxmShaderPatcherDestroy(gxm_shader_patcher);
+		if (rc < 0) return rc;
+		gxm_shader_patcher = NULL;
+	}
+
+	for (int i = 0; i < DISPLAY_MAX_BUFFER_COUNT; i++) {
+		if (gxm_sync_objects[i]) {
+			rc = sceGxmSyncObjectDestroy(gxm_sync_objects[i]);
+			if (rc < 0) return rc;
+			gxm_sync_objects[i] = NULL;
+		}
+	}
+
+	if (gxm_render_target) {
+		rc = sceGxmDestroyRenderTarget(gxm_render_target);
+		if (rc < 0) return rc;
+		gxm_render_target = NULL;
+	}
+#ifdef HAVE_SHARED_RENDERTARGETS
+	for (int i = 0; i < MAX_RENDER_TARGETS_NUM; i++) {
+		if (rt_list[i].rt) {
+			rc = sceGxmDestroyRenderTarget(rt_list[i].rt);
+			if (rc < 0) return rc;
+			vgl_memset(&rt_list[i], 0, sizeof(rt_list[i]));
+		}
+	}
+#endif
+
+	if (gxm_context) {
+		rc = sceGxmDestroyContext(gxm_context);
+		if (rc < 0) return rc;
+		gxm_context = NULL;
+	}
+
+	for (int i = 0; i < GXM_CONTEXTS_NUM; i++) {
+		if (vdm_ring_buffer_addr[i]) vgl_free(vdm_ring_buffer_addr[i]);
+		if (vertex_ring_buffer_addr[i]) vgl_free(vertex_ring_buffer_addr[i]);
+		if (fragment_ring_buffer_addr[i]) vgl_free(fragment_ring_buffer_addr[i]);
+		if (context_host_mem[i]) vgl_free(context_host_mem[i]);
+		if (fragment_usse_ring_buffer_addr[i]) gpu_fragment_usse_free_mapped(fragment_usse_ring_buffer_addr[i]);
+		vdm_ring_buffer_addr[i] = NULL;
+		vertex_ring_buffer_addr[i] = NULL;
+		fragment_ring_buffer_addr[i] = NULL;
+		context_host_mem[i] = NULL;
+		fragment_usse_ring_buffer_addr[i] = NULL;
+	}
+
+	if (gxm_shader_patcher_buffer_addr) vgl_free(gxm_shader_patcher_buffer_addr);
+	if (gxm_shader_patcher_vertex_usse_addr) gpu_vertex_usse_free_mapped(gxm_shader_patcher_vertex_usse_addr);
+	if (gxm_shader_patcher_fragment_usse_addr) gpu_fragment_usse_free_mapped(gxm_shader_patcher_fragment_usse_addr);
+	gxm_shader_patcher_buffer_addr = NULL;
+	gxm_shader_patcher_vertex_usse_addr = NULL;
+	gxm_shader_patcher_fragment_usse_addr = NULL;
+
+	for (int i = 0; i < DISPLAY_MAX_BUFFER_COUNT; i++) {
+		if (!system_app_mode && gxm_color_surfaces_addr[i])
+			vgl_free(gxm_color_surfaces_addr[i]);
+		gxm_color_surfaces_addr[i] = NULL;
+	}
+	if (system_app_mode && shared_fb_info.fb_base)
+		sceGxmUnmapMemory(shared_fb_info.fb_base);
+	if (gxm_depth_stencil_surface.depthData)
+		vgl_free(gxm_depth_stencil_surface.depthData);
+	if (gxm_depth_stencil_surface.stencilData)
+		vgl_free(gxm_depth_stencil_surface.stencilData);
+	vgl_memset(&gxm_depth_stencil_surface, 0, sizeof(gxm_depth_stencil_surface));
+
+	if (system_app_mode && shared_fb >= 0) {
+		sceSharedFbClose(shared_fb);
+		shared_fb = -1;
+	}
+	rc = vgl_mem_term();
+	if (rc < 0) return rc;
+	rc = sceGxmTerminate();
+	if (rc < 0 && !result) result = rc;
+	if (rc >= 0)
+		gxm_initialized = GL_FALSE;
+	needs_scene_reset = GL_TRUE;
+	scene_not_flushed = GL_FALSE;
+	return result;
+}
