+		int rc = sceGxmUnmapMemory(mempool_addr[VGL_MEM_EXTERNAL]);
+		if (rc < 0)
+			result = rc;
+		else
+			mempool_is_mapped[VGL_MEM_EXTERNAL] = GL_FALSE;
+	}
+
+	for (int i = 0; i < VGL_MEM_EXTERNAL; i++) {
+		if (mempool_addr[i] && mempool_is_mapped[i]) {
+#ifndef HAVE_CUSTOM_HEAP
+			if (mempool_mspace[i]) {
+				sceClibMspaceDestroy(mempool_mspace[i]);
+				mempool_mspace[i] = NULL;
+			}
+#endif
+			int rc = sceGxmUnmapMemory(mempool_addr[i]);
+			if (rc < 0) {
+				if (!result)
+					result = rc;
+			} else
+				mempool_is_mapped[i] = GL_FALSE;
+		}
+		if (!mempool_is_mapped[i] && mempool_uid[i] > 0) {
+			int rc = sceKernelFreeMemBlock(mempool_uid[i]);
+			if (rc < 0 && !result)
