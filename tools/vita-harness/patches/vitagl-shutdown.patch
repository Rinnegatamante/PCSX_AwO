+			if (rc >= 0)
+				mempool_uid[i] = 0;
+		}
+		if (!mempool_is_mapped[i] && mempool_uid[i] == 0) {
+			mempool_addr[i] = NULL;
+			mempool_end[i] = NULL;
+			mempool_size[i] = 0;
+		}
+	}
+	if (!mempool_is_mapped[VGL_MEM_EXTERNAL]) {
+		mempool_addr[VGL_MEM_EXTERNAL] = NULL;
+		mempool_end[VGL_MEM_EXTERNAL] = NULL;
+		mempool_size[VGL_MEM_EXTERNAL] = 0;
+	}
+	return result;
