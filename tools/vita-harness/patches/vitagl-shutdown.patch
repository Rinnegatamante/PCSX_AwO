+int vgl_mem_term(void) {
+	int result = 0;
+	// The GXM context, patcher, and queued resources must already be destroyed.
+	// Drop the mapping of newlib's externally-owned heap, but do not free it:
+	// the guest CRT owns that block and releases it after main returns.
