+void vglFramebufferMultisample(GLuint fb_id, SceGxmMultisampleMode mode) {
+	framebuffer *fb = (framebuffer *)fb_id;
+	if (!fb || fb->msaa == mode)
+		return;
+	fb->msaa = mode;
+
+	// The render target and depth/stencil surfaces were made for the old
+	// sample count: drop them (scene_reset recreates them) and rebuild the
+	// colour surface with the new scale.
+	if (fb->target) {
+		mark_rt_as_dirty(fb->target);
+		fb->target = NULL;
+	}
+	if (fb->depthbuffer_ptr) {
+#ifndef DEPTH_STENCIL_HACK
+		mark_as_dirty(fb->depthbuffer_ptr->depthData);
+		if (fb->depthbuffer_ptr->stencilData) {
+			mark_as_dirty(fb->depthbuffer_ptr->stencilData);
+		}
+#endif
+		fb->depthbuffer_ptr = NULL;
+		fb->depthbuffer_state &= ~DEPTHBUFFER_READY;
+	}
+	if (fb->tex)
+		_glFramebufferTexture2D(fb, GL_COLOR_ATTACHMENT0, fb->tex, 1);
+	if (in_use_framebuffer == fb)
+		dirty_framebuffer = GL_TRUE;
+}
